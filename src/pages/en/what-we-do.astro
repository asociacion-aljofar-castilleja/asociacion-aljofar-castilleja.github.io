---
import BaseLayout from "../../components/layout/BaseLayout/BaseLayout.astro";
import ServicesGrid from "../../components/sections/ServicesGrid/ServicesGrid.astro";
import ProjectsList from "../../components/sections/ProjectsList/ProjectsList.astro";
import Workshops from "../../components/sections/Workshops/Workshops.astro";
import { getEntry } from "astro:content";

const lang = "en";
const otherHref = "/que-hacemos";

type Service = {
  nombre?: string;
  objetivo?: string;
  destinatarios?: string;
  requisitos?: string;
  horario_lugar?: string;
  como_solicitar?: string;
  accesibilidad?: string;
};

type Project = {
  titulo?: string;
  financiacion?: string;
  resultados?: string;
  notas?: string;
  url?: string;   // optional external link
  fecha?: string; // optional year/range, e.g. "2023–2024"
};

type WorkshopImg = { src: string; alt?: string };
type Workshop = {
  titulo?: string;
  descripcion?: string;
  horario_lugar?: string;
  imagenes?: WorkshopImg[];
};

type PageData = {
  title?: string;
  description?: string;
  heroTitle?: string;
  heroSubtitle?: string;
  servicios?: Service[];   // services
  proyectos?: Project[];   // projects
  talleres?: Workshop[];   // workshops
};

const entry = await getEntry({ collection: "pages", id: "en/what-we-do" });
const data = (entry?.data ?? {}) as PageData;

const pageTitle = data.heroTitle ?? data.title ?? "What we do";
---

<BaseLayout
  lang={lang}
  title={data.title}
  description={data.description}
  otherHref={otherHref}
>
  {/* HERO for the page */}
  <header class="page-hero position-relative overflow-hidden">
    <div class="container py-4 py-lg-5 position-relative">
      <h1 class="display-5 fw-bold mb-2">{pageTitle}</h1>
      {data.heroSubtitle && (
        <p class="fs-5 mb-0 text-body-emphasis">{data.heroSubtitle}</p>
      )}
    </div>
  </header>

  <main id="main-content" class="whatwedo-page">
    {/* SECTION 1: Workshops */}
    {Array.isArray(data.talleres) && data.talleres.length > 0 && (
      <section
        id="workshops"
        class="whatwedo-section whatwedo-section--workshops"
      >
        <div class="container py-5">
          <Workshops lang={lang} items={data.talleres} />
        </div>
      </section>
    )}

    {/* SECTION 2: Services */}
    {Array.isArray(data.servicios) && data.servicios.length > 0 && (
      <section
        id="services"
        class="whatwedo-section whatwedo-section--services"
      >
        <div class="container py-5">
          <ServicesGrid lang={lang} items={data.servicios} />
        </div>
      </section>
    )}

    {/* SECTION 3: Projects */}
    {Array.isArray(data.proyectos) && data.proyectos.length > 0 && (
      <section
        id="projects"
        class="whatwedo-section whatwedo-section--projects"
      >
        <div class="container py-5">
          <ProjectsList lang={lang} items={data.proyectos} />
        </div>
      </section>
    )}
  </main>
</BaseLayout>
