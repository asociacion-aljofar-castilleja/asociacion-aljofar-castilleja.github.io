---
import Header from "../Header/Header.astro";
import Footer from "../Footer/Footer.astro";
import { getEntry } from "astro:content";

// SCSS global
import "../../../styles/main.scss";

type Lang = "es" | "en";
interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  otherHref?: string;
}

const {
  lang = "es",
  title,
  description,
  otherHref,
} = Astro.props as Props;

const compIdMap = { es: "baselayout/es", en: "baselayout/en" } as const;
type CompId = (typeof compIdMap)[Lang];

interface LayoutI18n {
  skipToContent?: string;
  meta?: {
    defaultTitle?: string;
    defaultDescription?: string;
    siteName?: string;
    baseUrl?: string;      // opcional, por si quieres fijar origen a mano
    defaultImage?: string; // puede ser absoluta o relativa
  };
}

const entry = await getEntry({ collection: "ui", id: compIdMap[lang] as CompId });
const I = (entry?.data ?? {}) as LayoutI18n;

// ===== Fallbacks globales =====
const fallbackTitle =
  lang === "es"
    ? "Asociación ALJÓFAR – Castilleja de la Cuesta"
    : "ALJÓFAR Association – Castilleja de la Cuesta";

const fallbackDescription =
  lang === "es"
    ? "No queremos ser normales, queremos ser felices. Asociación Andaluza para la integración, formación y desarrollo en la sociedad de las personas con diversidad funcional, psíquica, física y sensorial ALJÓFAR de Castilleja de la Cuesta (Sevilla)."
    : "We don't want to be normal, we want to be happy. Andalusian Association for the inclusion, training and development in society of people with intellectual, physical and sensory disabilities ALJÓFAR from Castilleja de la Cuesta (Seville).";

// Texto del enlace “Saltar al contenido”
const skipText =
  I.skipToContent ??
  (lang === "en" ? "Skip to content" : "Saltar al contenido");

// ===== META: prioridad =====
// 1) YAML baselayout (meta.defaultTitle / meta.defaultDescription)
// 2) Props de la página
// 3) Fallbacks hardcodeados
const pageTitle =
  I.meta?.defaultTitle ?? title ?? fallbackTitle;

const pageDescription =
  I.meta?.defaultDescription ?? description ?? fallbackDescription;

// Site name (para OG)
const siteName =
  I.meta?.siteName ??
  (lang === "es"
    ? "Asociación ALJÓFAR"
    : "ALJÓFAR Association");

// URL actual y sitio configurado en astro.config.mjs
const currentUrl = Astro.url;
const siteFromConfig = Astro.site;

// URL base para construir absolutas (prioridad: meta.baseUrl > Astro.site)
const baseForMeta =
  I.meta?.baseUrl
    ? new URL(I.meta.baseUrl)
    : siteFromConfig
    ? new URL(siteFromConfig)
    : null;

// Canonical absoluta si tenemos origen, si no, usa tal cual la actual
const canonicalUrl = baseForMeta
  ? new URL(currentUrl.pathname + currentUrl.search, baseForMeta).toString()
  : currentUrl.href;

// Imagen OG (puede venir del YAML o fallback relativa)
const rawOgImage =
  I.meta?.defaultImage ?? "/images/seo/aljofar-og-default.png";

// Convertimos a URL absoluta para que WhatsApp/Facebook la entiendan
const ogImageUrl = (() => {
  // Si ya es absoluta (http/https), la dejamos tal cual
  if (/^https?:\/\//i.test(rawOgImage)) {
    return rawOgImage;
  }

  // Si tenemos baseForMeta (config o baseUrl), resolvemos ahí
  if (baseForMeta) {
    return new URL(rawOgImage, baseForMeta).toString();
  }

  // Último recurso: usar origen de la URL actual
  try {
    const origin = new URL(currentUrl.href).origin;
    return new URL(rawOgImage, origin).toString();
  } catch {
    // Si todo falla, devolvemos la ruta tal cual (peor caso, como antes)
    return rawOgImage;
  }
})();

// Locale para OG
const ogLocale = lang === "es" ? "es_ES" : "en_GB";
---

<!DOCTYPE html>
<html lang={lang} data-bs-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    {/* ===== Favicon & PWA ===== */}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* ===== Open Graph (Facebook, WhatsApp, etc.) ===== */}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content={pageTitle} />

    {/* Opcional pero recomendado si sabes el tamaño real de la imagen */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* ===== Twitter / X Cards ===== */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* ===== Bootstrap Icons ===== */}
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
  </head>
  <body>
    <a class="visually-hidden-focusable" href="#main-content">{skipText}</a>

    <Header lang={lang} otherHref={otherHref} />
    <main id="main-content" class="py-4">
      <slot />
    </main>
    <Footer lang={lang} />

    {
      import.meta.env.DEV ? (
        // Desarrollo: el dev server sirve el TS con HMR
        <script type="module">import "/src/scripts/app.ts";</script>
      ) : (
        // Producción (Pages): carga el bundle único generado por esbuild
        <script type="module" src="/_astro/app.js"></script>
      )
    }
  </body>
</html>
