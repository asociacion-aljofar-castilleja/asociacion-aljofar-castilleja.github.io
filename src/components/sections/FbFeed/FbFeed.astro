---
import { getEntry } from "astro:content";

type Lang = "es" | "en";
interface Props {
  lang: Lang;
  pageUrl: string;   // URL de la página de Facebook
  width?: number;    // ancho del plugin, por defecto 500
  height?: number;   // alto del plugin, por defecto 800
  showNote?: boolean;
}

const { lang, pageUrl, width = 500, height = 800, showNote = true } = Astro.props as Props;

// i18n (colección "ui", id: "FbFeed/es|en")
const idMap = { es: "fbfeed/es", en: "fbfeed/en" } as const;
type FbFeedI18n = {
  title?: string;
  ariaSection?: string;
  viewOnFacebook?: string;
  openInNew?: string;
  privacyNote?: string;
  introText?: string; // texto introductorio
};

const i18nEntry = await getEntry({ collection: "ui", id: idMap[lang] });
const I = (i18nEntry?.data ?? {}) as FbFeedI18n;

const title = I.title ?? (lang === "en" ? "Latest news" : "Últimas noticias");
const ariaSection = I.ariaSection ?? title;

// Párrafo introductorio con traducción
const introText = I.introText ?? (lang === "en"
  ? "At ALJÓFAR, we work every day to build a more inclusive society, promoting autonomy, respect, and participation for all people with functional diversity. Follow us on Facebook to see our activities, workshops, events, and projects, and discover how together we foster integration and happiness in our community."
  : "En ALJÓFAR trabajamos cada día por construir una sociedad más inclusiva, fomentando la autonomía, el respeto y la participación de todas las personas con diversidad funcional. Síguenos en Facebook para conocer nuestras actividades, talleres, eventos y proyectos, y descubre cómo juntos promovemos la integración y la felicidad de nuestra comunidad.");
---

<section class="fbfeed-section py-5" aria-label={ariaSection} data-module="FbFeed">
  <div class="container">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
      <h2 class="mb-0">{title}</h2>
      <a class="btn btn-outline-secondary btn-sm" href={pageUrl} target="_blank" rel="noopener">
        {I.viewOnFacebook ?? (lang === "en" ? "View on Facebook" : "Ver en Facebook")}
        <span class="visually-hidden">
          — {I.openInNew ?? (lang === "en" ? "Opens in a new window" : "Se abre en una ventana nueva")}
        </span>
      </a>
    </div>

    {showNote && (
      <p class="small text-body-secondary mb-3">
        {I.privacyNote ?? (lang === "en"
          ? "This block loads content from Facebook. It may use cookies."
          : "Este bloque carga contenido de Facebook. Puede usar cookies.")}
      </p>
    )}

    <!-- Párrafo introductorio -->
    <p class="mb-4">{introText}</p>

    <div class="fbfeed-embed position-relative d-flex justify-content-center">
      <!-- Facebook Page Plugin centrado -->
      <div
        class="fb-page"
        data-href={pageUrl}
        data-tabs="timeline"
        data-width={width}
        data-height={height}
        data-small-header="false"
        data-adapt-container-width="true"
        data-hide-cover="false"
        data-show-facepile="false"
        style="max-width:500px; width:100%;"
      ></div>

      <noscript>
        <div class="mt-3 text-center">
          <a class="btn btn-outline-secondary btn-sm" href={pageUrl} target="_blank" rel="noopener">
            {I.viewOnFacebook ?? (lang === "en" ? "View on Facebook" : "Ver en Facebook")}
          </a>
        </div>
      </noscript>
    </div>
  </div>

  <!-- SDK de Facebook -->
  <script async defer crossorigin="anonymous" src="https://connect.facebook.net/en_US/sdk.js#xfbml=1&version=v17.0" nonce="FbFeedSDK"></script>
</section>
