---
import { getEntry } from "astro:content";

type Lang = "es" | "en";

type ItemImage =
  | string
  | {
      src: string;
      alt?: string;
      aspectRatio?: `${number}/${number}` | "16/9" | "4/3" | "1/1";
    };

type ItemTipo = "actividad" | "puesto" | "imagen";

type Item = {
  titulo?: string;
  fecha?: string;
  url?: string;
  notas?: string;
  imagen?: ItemImage;
  tipo?: ItemTipo;

  // ACTIVITIES
  lugar?: string;
  horario?: string;
  precio?: string;
  edad?: string;
  organizador?: string;

  // STALLS
  ubicacion?: string;
  productos?: string;
  contacto?: string;

  // CUSTOM CLASS
  clase?: string;
};

interface Props {
  lang: Lang;
  proyectos?: any[];
  items?: Item[];
  titleOverride?: string;
  showIcons?: boolean;
}

const {
  lang,
  proyectos = [],
  items = [],
  titleOverride,
  showIcons = true,
} = Astro.props as Props;

const idMap = { es: "leisure/es", en: "leisure/en" } as const;

type I18n = {
  title?: string;
  ariaSection?: string;
  labels?: Record<string,string>;
  empty?: string;
};

const entry = await getEntry({ collection: "ui", id: idMap[lang] });
const I = (entry?.data ?? {}) as I18n;

const title = titleOverride ?? I.title ?? (lang === "en" ? "Leisure & Stalls" : "Actividades y Puestos");
const ariaSection = I.ariaSection ?? title;

const L = {
  actividad:   I.labels?.actividad   ?? (lang === "en" ? "Activity" : "Actividad"),
  puesto:      I.labels?.puesto      ?? (lang === "en" ? "Stall" : "Puesto"),
  lugar:       I.labels?.lugar       ?? (lang === "en" ? "Place" : "Lugar"),
  horario:     I.labels?.horario     ?? (lang === "en" ? "Schedule" : "Horario"),
  precio:      I.labels?.precio      ?? (lang === "en" ? "Price" : "Precio"),
  edad:        I.labels?.edad        ?? (lang === "en" ? "Age" : "Edad"),
  organizador: I.labels?.organizador ?? (lang === "en" ? "Organizer" : "Organizador"),
  ubicacion:   I.labels?.ubicacion   ?? (lang === "en" ? "Location" : "Ubicación"),
  productos:   I.labels?.productos   ?? (lang === "en" ? "Products" : "Productos"),
  contacto:    I.labels?.contacto    ?? (lang === "en" ? "Contact" : "Contacto"),
  notas:       I.labels?.notas       ?? (lang === "en" ? "Notes" : "Notas"),
  leerMas:     I.labels?.leerMas     ?? (lang === "en" ? "Read more" : "Más info"),
  fecha:       I.labels?.fecha       ?? (lang === "en" ? "Date" : "Fecha"),
};

const emptyText = I.empty ?? (lang === "en" ? "Nothing listed yet." : "Aún no hay elementos.");

function normalizeImg(img?: ItemImage) {
  if (!img) return null;
  if (typeof img === "string") return { src: img, alt: "", aspectRatio: "16/9" as const };
  return { src: img.src, alt: img.alt ?? "", aspectRatio: img.aspectRatio ?? ("16/9" as const) };
}

function icon(key: keyof typeof L) {
  if (!showIcons) return null;
  const map: Record<string, string> = {
    actividad: "🎉",
    puesto: "🛍️",
    lugar: "📍",
    horario: "⏰",
    precio: "💶",
    edad: "👤",
    organizador: "🏷️",
    ubicacion: "🗺️",
    productos: "🧺",
    contacto: "☎️",
    notas: "📝",
    fecha: "📅",
  };
  return map[key] ?? "•";
}

function adaptFromProyectosLegacy(p: any): Item {
  const hasNewKeys =
    p.tipo || p.lugar || p.horario || p.precio || p.edad || p.organizador || p.ubicacion || p.productos || p.contacto;
  if (hasNewKeys) return { ...p };
  const text = `${p.resultados ?? ""} ${p.financiacion ?? ""}`.toLowerCase();
  const isPuesto = /(venta|puesto|mercad|stand|art(esan|esanía)|productos?)/.test(text);
  return {
    titulo: p.titulo,
    fecha: p.fecha,
    url: p.url,
    imagen: p.imagen,
    tipo: isPuesto ? "puesto" : "actividad",
    notas: p.notas ?? p.resultados ?? p.financiacion,
  };
}

const sourceItems: Item[] =
  (items?.length ? items : proyectos?.map(adaptFromProyectosLegacy)) ?? [];
---

<section class="leisure-list py-3" aria-label={ariaSection} data-module="ProyectList">
  <div class="container">
    <h2 class="h4 mb-3">{title}</h2>

    {sourceItems.length === 0 ? (
      <p class="text-muted">{emptyText}</p>
    ) : (
      <ul class="project-list list-unstyled m-0">
        {sourceItems.map((p) => {
          const img = normalizeImg(p.imagen);
          const tipo = p.tipo ?? (p.productos || p.ubicacion ? "puesto" : "actividad");
          return (
            <li class="project-item">
              <article class={`project-card ${p.clase ?? ""}`}>
                {img ? (
                  <figure class="project-media" style={{ "--ratio": img.aspectRatio }}>
                    <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
                  </figure>
                ) : (
                  <figure class="project-media project-media--placeholder" aria-hidden="true">
                    <div class="ph"><span>▣</span></div>
                  </figure>
                )}

                {tipo !== "imagen" && (
                  <div class="card-body">
                    {p.titulo && (
                      <h3 class="project-title h6 m-0">
                        {showIcons && <span class="project-icon" aria-hidden="true">{icon(tipo as any)}</span>}
                        {p.titulo}
                      </h3>
                    )}
                    {p.fecha && <span class="project-date badge text-bg-light">{p.fecha}</span>}

                    {tipo === "actividad" && (
                      <>
                        {p.lugar && <p><strong>{L.lugar}:</strong> {p.lugar}</p>}
                        {p.horario && <p><strong>{L.horario}:</strong> {p.horario}</p>}
                        {p.precio && <p><strong>{L.precio}:</strong> {p.precio}</p>}
                        {p.edad && <p><strong>{L.edad}:</strong> {p.edad}</p>}
                        {p.organizador && <p><strong>{L.organizador}:</strong> {p.organizador}</p>}
                      </>
                    )}

                    {tipo === "puesto" && (
                      <>
                        {p.ubicacion && <p><strong>{L.ubicacion}:</strong> {p.ubicacion}</p>}
                        {p.horario && <p><strong>{L.horario}:</strong> {p.horario}</p>}
                        {p.productos && <p><strong>{L.productos}:</strong> {p.productos}</p>}
                        {p.contacto && <p><strong>{L.contacto}:</strong> {p.contacto}</p>}
                      </>
                    )}

                    {p.notas && <p><strong>{L.notas}:</strong> {p.notas}</p>}

                    {p.url && (
                      <div class="mt-2">
                        <a class="btn btn-sm btn-outline-primary" href={p.url} target="_blank" rel="noopener">
                          {L.leerMas}
                        </a>
                      </div>
                    )}
                  </div>
                )}
              </article>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</section>
