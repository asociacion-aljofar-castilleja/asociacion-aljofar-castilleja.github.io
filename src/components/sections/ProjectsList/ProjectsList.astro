---
import { getEntry } from "astro:content";

type Lang = "es" | "en";

type ItemImage =
  | string
  | {
      src: string;
      alt?: string;
      aspectRatio?: `${number}/${number}` | "16/9" | "4/3" | "1/1";
    };

type ItemTipo = "actividad" | "puesto" | "imagen";

type Item = {
  titulo?: string;
  fecha?: string;
  url?: string;
  info?: string;
  imagen?: ItemImage;
  tipo?: ItemTipo;

  // ACTIVIDADES
  lugar?: string;
  edad?: string;
  organizador?: string;

  // PUESTOS
  ubicacion?: string;
  productos?: string;
  contacto?: string;

  // clase extra opcional
  clase?: string;
};

interface Props {
  lang: Lang;
  proyectos?: Item[];
  items?: Item[];
  titleOverride?: string;
}

const {
  lang,
  proyectos = [],
  items = [],
  titleOverride,
} = Astro.props as Props;

const idMap = { es: "leisure/es", en: "leisure/en" } as const;

type I18n = {
  title?: string;
  ariaSection?: string;
  labels?: Record<string, string>;
  empty?: string;
};

const entry = await getEntry({ collection: "ui", id: idMap[lang] });
const I = (entry?.data ?? {}) as I18n;

const title =
  titleOverride ??
  I.title ??
  (lang === "en" ? "Leisure activities & stalls" : "Actividades y puestos solidarios");

const ariaSection = I.ariaSection ?? title;

const L = {
  actividad:   I.labels?.actividad   ?? (lang === "en" ? "Activity" : "Actividad"),
  puesto:      I.labels?.puesto      ?? (lang === "en" ? "Stall" : "Puesto solidario"),
  lugar:       I.labels?.lugar       ?? (lang === "en" ? "Place" : "Lugar"),
  edad:        I.labels?.edad        ?? (lang === "en" ? "Age" : "Edad"),
  organizador: I.labels?.organizador ?? (lang === "en" ? "Organizer" : "Organizador"),
  ubicacion:   I.labels?.ubicacion   ?? (lang === "en" ? "Location" : "Ubicación"),
  productos:   I.labels?.productos   ?? (lang === "en" ? "Products" : "Productos"),
  contacto:    I.labels?.contacto    ?? (lang === "en" ? "Contact" : "Contacto"),
  info:        I.labels?.info        ?? (lang === "en" ? "Description" : "Descripción"),
  leerMas:     I.labels?.leerMas     ?? (lang === "en" ? "Read more" : "Más info"),
  fecha:       I.labels?.fecha       ?? (lang === "en" ? "Date" : "Fecha"),
};

const emptyText =
  I.empty ?? (lang === "en" ? "Nothing listed yet." : "Aún no hay actividades ni puestos.");

function normalizeImg(img?: ItemImage) {
  if (!img) return null;
  if (typeof img === "string") {
    return { src: img, alt: "", aspectRatio: "16/9" as const };
  }
  return {
    src: img.src,
    alt: img.alt ?? "",
    aspectRatio: img.aspectRatio ?? ("16/9" as const),
  };
}

// Fuente: items > proyectos
const sourceItems: Item[] = (items?.length ? items : proyectos) ?? [];
---

<section
  class="leisure-list py-3"
  aria-label={ariaSection}
  data-module="ProyectList"
>
  <div class="container">
    <h2 class="h4 mb-3">{title}</h2>

    {sourceItems.length === 0 ? (
      <p class="text-muted">{emptyText}</p>
    ) : (
      <ul class="project-list list-unstyled m-0">
        {sourceItems.map((p) => {
          const img = normalizeImg(p.imagen);
          const tipo: ItemTipo =
            p.tipo ?? (p.ubicacion || p.productos || p.contacto ? "puesto" : "actividad");

          return (
            <li class="project-item">
              <article class={`project-card ${p.clase ?? ""}`}>
                {img ? (
                  <figure class="project-media" style={{ "--ratio": img.aspectRatio }}>
                    <img
                      src={img.src}
                      alt={img.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                ) : (
                  <figure
                    class="project-media project-media--placeholder"
                    aria-hidden="true"
                  >
                    <div class="ph">
                      <span>▣</span>
                    </div>
                  </figure>
                )}

                <div class="card-body">
                  {/* Badge tipo (solo texto) */}
                  {tipo !== "imagen" && (
                    <span class="project-type badge rounded-pill text-bg-light mb-2">
                      {tipo === "puesto" ? L.puesto : L.actividad}
                    </span>
                  )}

                  {/* Título */}
                  {p.titulo && (
                    <h3 class="project-title h6 m-0 mb-1">
                      {p.titulo}
                    </h3>
                  )}

                  {/* Metadatos */}
                  <ul class="project-meta list-unstyled small mb-2">
                    {p.fecha && (
                      <li>
                        <span class="project-meta-label">{L.fecha}:</span>{" "}
                        <span>{p.fecha}</span>
                      </li>
                    )}
                    {p.lugar && (
                      <li>
                        <span class="project-meta-label">{L.lugar}:</span>{" "}
                        <span>{p.lugar}</span>
                      </li>
                    )}
                    {p.ubicacion && (
                      <li>
                        <span class="project-meta-label">{L.ubicacion}:</span>{" "}
                        <span>{p.ubicacion}</span>
                      </li>
                    )}
                    {p.edad && (
                      <li>
                        <span class="project-meta-label">{L.edad}:</span>{" "}
                        <span>{p.edad}</span>
                      </li>
                    )}
                    {p.organizador && (
                      <li>
                        <span class="project-meta-label">{L.organizador}:</span>{" "}
                        <span>{p.organizador}</span>
                      </li>
                    )}
                    {p.productos && (
                      <li>
                        <span class="project-meta-label">{L.productos}:</span>{" "}
                        <span>{p.productos}</span>
                      </li>
                    )}
                    {p.contacto && (
                      <li>
                        <span class="project-meta-label">{L.contacto}:</span>{" "}
                        <span>{p.contacto}</span>
                      </li>
                    )}
                  </ul>

                  {/* Descripción */}
                  {p.info && (
                    <p class="project-info mb-0">
                      {p.info}
                    </p>
                  )}

                  {/* Enlace opcional */}
                  {p.url && (
                    <div class="mt-2">
                      <a
                        class="btn btn-sm btn-outline-primary"
                        href={p.url}
                        target="_blank"
                        rel="noopener"
                      >
                        {L.leerMas}
                      </a>
                    </div>
                  )}
                </div>
              </article>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</section>
