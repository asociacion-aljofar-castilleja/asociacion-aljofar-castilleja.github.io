---
import WorkshopCard from "./WorkshopCard.astro";
import fs from "fs";
import path from "path";
import yaml from "js-yaml";

// idioma (cambiar a "en" para inglés)
const lang: "es" | "en" = Astro.props.lang ?? "es";

// cargar YAML dinámicamente según idioma
const filePath = path.resolve(`src/content/pages/${lang === "es" ? "es/que-hacemos.yaml" : "en/what-we-do.yaml"}`);
const fileContents = fs.readFileSync(filePath, "utf-8");
const data = yaml.load(fileContents) as any;

// extraer talleres desde el YAML
const workshops = data.talleres?.map((w: any) => ({
  titulo: w.titulo,                // puede ser string o { es, en }
  descripcion: w.descripcion,
  horario_lugar: w.horario_lugar,
  imagenes: w.imagenes?.map((img: any) => ({
    src: img.src,
    alt: img.alt
  })) ?? []
})) ?? [];
---

<section class="whatwedo-workshops py-3" aria-label={lang === "es" ? "Talleres y Actividades" : "Workshops and Activities"} data-module="Workshops">
  <div class="container">
    <h2 class="h4 mb-3">{lang === "es" ? "Talleres y Actividades" : "Workshops and Activities"}</h2>

    {workshops.length === 0 ? (
      <p class="text-muted">{lang === "es" ? "Aún no hay talleres." : "No workshops yet."}</p>
    ) : (
      <div class="row row-cols-1 row-cols-md-2 g-4">
        {workshops.map((w, idx) => (
          <div class="col d-flex">
            <WorkshopCard lang={lang} w={w} idBase={`workshop-${idx}`} />
          </div>
        ))}
      </div>
    )}
  </div>
</section>
